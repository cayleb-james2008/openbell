// Paper research shape: late convergence cap.
// Buy YES inside the final 4 minutes (never the final minute) once implied
// probability converges into 72c-90c with tight liquidity (spread <= 3c),
// capping entry at 90c to avoid extreme tail risk above 90c.
// Scored strictly on paper by the shadow scorer — this file places nothing.

pub fn name() {
    "late-convergence-cap"
}

pub fn side() {
    "yes"
}

pub fn describe() {
    "Buy high-conviction late YES convergence (72c-90c cap, spread <=3c) with 1m-4m left."
}

pub fn allow_entry(yes_ask, no_ask, secs_to_close) {
    if secs_to_close > 240 || secs_to_close < 61 {
        return false;
    }
    if yes_ask < 0.72 || yes_ask > 0.90 || no_ask < 0.01 || no_ask > 0.99 {
        return false;
    }
    let spread = yes_ask + no_ask - 1.0;
    if spread < -0.001 || spread > 0.035 {
        return false;
    }
    let cents = yes_ask * 100.0;
    (cents - cents.round()).abs() < 0.000001
}

pub fn entry_quote(yes_ask, no_ask, secs_to_close) {
    if allow_entry(yes_ask, no_ask, secs_to_close) {
        Some((yes_ask * 100.0).round() / 100.0)
    } else {
        None
    }
}
